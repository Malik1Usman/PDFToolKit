# Set default behavior to handle line endings automatically and normalize to LF
* text=auto eol=lf

# Kotlin, Java, XML, and Gradle files
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell scripts & Gradle wrapper must have LF endings
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files must retain CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.aar binary
*.keystore binary
*.jks binary
